{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Angular dev server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/@angular/cli/bin/ng.js",
      "args": [
        "serve",
        "--host",
        "127.0.0.1",
        "--port",
        "4201"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "NG_CLI_ANALYTICS": "false"
      },
      "console": "internalConsole",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Angular browser",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:4201",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true
    },
    {
      "name": "Angular + Browser MCP",
      "type": "browser-mcp",
      "request": "launch",
      "target": "Angular browser",
      "startupTimeout": 180000,
      "browser": {
        "type": "chrome",
        "userDataDir": "${workspaceFolder}/../../.tmp/angular-demo/extension-chrome-profile"
      },
      "playwrightMcp": {
        "enabled": true,
        "package": "@playwright/mcp@0.0.85",
        "port": 8931
      },
      "chromeDevtoolsMcp": {
        "enabled": true,
        "package": "chrome-devtools-mcp@1.12.0",
        "port": 8932
      }
    }
  ]
}
